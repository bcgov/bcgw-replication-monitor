{
  "name": "sync",
  "description": "Syncs FME Flow job runs into the Replication Monitor database",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint:fix": "eslint --fix \"./**/*.{js,ts}\"",
    "lint": "eslint \"./**/*.{js,ts}\"",
    "format": "prettier --write \"./**/*.{js,ts,json}\"",
    "test": "vitest run"
  },
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "dotenv": "^18.0.9",
    "oracledb": "^26.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/oracledb": "^26.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
